{
  "name": "@starry-phd/life",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "vite build && node scripts/bundle.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "generate:api": "openapi-typescript vendor/starry-id.v1.json -o src/generated/starry-api.ts",
    "ci": "npm run typecheck && npm test && npm run build",
    "index:content": "node scripts/index-content.mjs",
    "check:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "jose": "^6.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "latest",
    "@playwright/test": "^1.65.0",
    "@types/node": "^22.0.0",
    "cf": "^1.0.0-beta.30",
    "esbuild": "^0.25.0",
    "openapi-typescript": "^7.10.0",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
